<!--
    Mingo * a touchscreen companion skin for a Denon SC Live 4 standalone
    build (1280x720 @ ~210 ppi)

    Mingo shows only what the SC Live 4 control surface cannot: zoomed
    and scan waveforms for all four decks, track identity (title, artist,
    key) and the active beat FX preset name. Decks are presented as two
    hard-synced pairs (1+3, 2+4); all performance controls and their
    readouts (BPM, time, control positions, artwork, spinners) live on
    the hardware.

    See DESIGN.md for the decision record and PLAN.md for the build plan.
-->

<skin>
  <manifest>
    <title>Mingo</title>
    <author>Phil Willoughby (DJ WillerZ)</author>
    <version>0.1</version>
    <description>Touchscreen companion display for the Denon SC Live 4: paired-deck waveforms, track identity and beat FX preset name, sized for 1280x720 touch.</description>
    <language>en</language>
    <license>Creative Commons Attribution, Share-Alike 3.0 Unported</license>

  <!--    ################################################################
          Control Objects  ##############################################
        ###############################################################
  -->
    <attributes>
      <!-- Set skin defaults. -->
      <attribute config_key="[App],num_decks">4</attribute>
      <attribute config_key="[App],num_samplers">16</attribute>
      <attribute persist="true" config_key="[Mingo],colorLogo">1</attribute>
      <attribute persist="false" config_key="[Mingo],fx_slot_1">1</attribute>
      <attribute persist="false" config_key="[Mingo],fx_slot_2">0</attribute>
      <attribute persist="false" config_key="[Mingo],fx_slot_3">0</attribute>
      <attribute persist="false" config_key="[Mingo],fx_slot_4">0</attribute>
      <attribute persist="false" config_key="[Mingo],fx_slot_5">0</attribute>
      <attribute persist="false" config_key="[Mingo],fx_slot_6">0</attribute>
      <!-- Decks -->
      <attribute persist="true" config_key="[Skin],show_intro_outro_cues">1</attribute>
      <attribute persist="true" config_key="[Mingo],key_display_match">1</attribute>
      <!-- Library -->
      <attribute config_key="[Skin],show_maximized_library">0</attribute>
      <!--Disable hidden effect routing Buttons-->
      <attribute persist="false" config_key="[EffectRack1_EffectUnit1],group_[MasterOutput]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit1],group_[BusLeft]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit1],group_[BusCenter]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit1],group_[BusRight]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit1],group_[BusTalkover]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit2],group_[MasterOutput]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit2],group_[BusLeft]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit2],group_[BusCenter]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit2],group_[BusRight]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit2],group_[BusTalkover]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit3],group_[MasterOutput]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit3],group_[BusLeft]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit3],group_[BusCenter]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit3],group_[BusRight]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit3],group_[BusTalkover]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit4],group_[MasterOutput]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit4],group_[BusLeft]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit4],group_[BusCenter]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit4],group_[BusRight]_enable">0</attribute>
      <attribute persist="false" config_key="[EffectRack1_EffectUnit4],group_[BusTalkover]_enable">0</attribute>
    </attributes>
  </manifest>

  <ObjectName>Mixxx</ObjectName>
  <Style src="skins:Mingo/style.qss"
         src-mac="skins:Mingo/style-mac.qss"
         src-linux="skins:default-menu-styles-linux.qss"
         src-windows="skins:default-menu-styles-windows.qss"/>
  <MinimumSize>1008,500</MinimumSize>
  <SizePolicy>me,me</SizePolicy>
  <Layout>vertical</Layout>

<!--  ################################################################
       Launch Image  ################################################
     ###############################################################
-->
    <LaunchImageStyle>
      LaunchImage {
        background-color: #0f0f0f;
      }
      QLabel {
        image: url(skins:Mingo/graphics/logo_160x40.svg);
        padding: 0;
        margin: 0px 2px 0px 2px;
        border: none;
        min-width: 160px;
        min-height: 40px;
        max-width: 160px;
        max-height: 40px;
      }
      QProgressBar {
        background-color: #333333;
        border: none;
        min-width: 164px;
        min-height: 3px;
        max-width: 164px;
        max-height: 3px;
      }
      QProgressBar::chunk {
        background-color: #FF6100;
      }
    </LaunchImageStyle>
  <Children>

<!--  ################################################################
      Variables #####################################################
     ###############################################################
      Put these variable definitions at the beginning in order to have
      have all variables available for SingletonDefinitions -->

    <SetVariable name="SignalRGBLowColor">#ff2a00</SetVariable>
    <SetVariable name="SignalRGBMidColor">#33f600</SetVariable>
    <SetVariable name="SignalRGBHighColor">#332acc</SetVariable>
    <SetVariable name="PlayedOverlayColor">#99000000</SetVariable>
    <!-- Cyan end-of-track warning -->
    <SetVariable name="EndOfTrackColor">#00ffff</SetVariable>
    <!-- Mingo: pairs read as one unit — pair 1|3 purple, pair 2|4 blue -->
    <SetVariable name="SignalColor_PairA">#DF4DF0</SetVariable>
    <SetVariable name="SignalBgColor_PairA">#3A0440</SetVariable>
    <SetVariable name="SignalColor_PairB">#5EBAFF</SetVariable>
    <SetVariable name="SignalBgColor_PairB">#0B1E26</SetVariable>
    <!-- Signal color for waveform overview in decks 1/2, preview deck, samplers and library -->
    <SetVariable name="SignalColor">#bababa</SetVariable>

<!--################################################################
     Singleton definitions  #######################################
   ############################################################### -->

    <!-- Overviews are needed in both regular and minimal decks -->
    <SingletonDefinition>
      <ObjectName>DeckOverviewSingleton1</ObjectName>
      <Children>
        <Template src="skins:Mingo/decks/overview.xml">
          <SetVariable name="chanNum">1</SetVariable>
          <SetVariable name="SignalBgColor"><Variable name="SignalBgColor_PairA"/></SetVariable>
          <SetVariable name="SignalColor"><Variable name="SignalColor_PairA"/></SetVariable>
        </Template>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>DeckOverviewSingleton2</ObjectName>
      <Children>
        <Template src="skins:Mingo/decks/overview.xml">
          <SetVariable name="chanNum">2</SetVariable>
          <SetVariable name="SignalBgColor"><Variable name="SignalBgColor_PairB"/></SetVariable>
          <SetVariable name="SignalColor"><Variable name="SignalColor_PairB"/></SetVariable>
        </Template>
      </Children>
    </SingletonDefinition>

    <SingletonDefinition>
      <ObjectName>Library_Singleton</ObjectName>
      <Children>
        <Template src="skins:Mingo/library.xml"/>
      </Children>
    </SingletonDefinition>

    <!-- FX units 1 & 2 show up at different places, depending on the number
    of units enabled (2 or 4). -->


<!--  ##############################################################
      SkinContainer ################################################
      skin incl. invisible size detector for deck Stars ############
      ############################################################## -->
    <WidgetGroup>
      <ObjectName>SkinContainer</ObjectName>
      <Layout>vertical</Layout>
      <SizePolicy>me,me</SizePolicy>
      <Children>
      <!--[
            [
              [ [ topbar ]
                [ [ #1 normal library
                    [ stacked scrolling waveforms ]
                    [ decks ]
                    [ fx units ]
                    [ samplers ]
                    [ mic/aux ]
                    [ Library ] ]
                  [ #2 maximized Library
                    [ minimal decks ]
                    [ Library ] ]
                ]
                [ skin settings menu ]
              ]
            [ star rating space detector ]
          ]
         -->
        <WidgetGroup><!-- visible skin + size settings menu -->
          <Layout>horizontal</Layout>
          <SizePolicy>me,me</SizePolicy>
          <Children>

            <WidgetGroup><!-- topbar + skin elements -->
              <Layout>vertical</Layout>
              <SizePolicy>me,me</SizePolicy>
              <Children>

                <Template src="skins:Mingo/topbar.xml"/>

                <!-- regular / maximized library -->
                <WidgetStack currentpage="[Skin],show_maximized_library">
                  <Children>
                    <!-- regular library
                        [stacked  waveforms]
                        [decks, FX, samplers, Mic/Aux]
                        [Library] -->
                    <Splitter>
                      <ObjectName>WaveformSplitter</ObjectName>
                      <Orientation>vertical</Orientation>
                      <SizePolicy>me,me</SizePolicy>
                      <SplitSizes>458,242</SplitSizes>
                      <SplitSizesConfigKey>[Skin],stackedWaveforms_splitSize</SplitSizesConfigKey>
                      <Collapsible>0,0</Collapsible>
                      <Connection>
                        <ConfigKey>[Skin],show_maximized_library</ConfigKey>
                        <Transform><Not/></Transform>
                        <BindProperty>visible</BindProperty>
                      </Connection>
                      <Children>

                      <WidgetGroup><!-- decks -->
                          <ObjectName>MingoPairColumns</ObjectName>
                          <Layout>vertical</Layout>
                          <SizePolicy>me,max</SizePolicy>
                          <Children>
                            <WidgetGroup><!-- track info for deck pairs -->
                              <ObjectName>MingoPairColumns</ObjectName>
                              <Layout>horizontal</Layout>
                              <SizePolicy>me,me</SizePolicy>
                              <Children>
                                <Template src="skins:Mingo/decks/deck_left_mini.xml">
                                  <SetVariable name="chanNum">1</SetVariable>
                                </Template>
                                <Template src="skins:Mingo/decks/deck_right_mini.xml">
                                  <SetVariable name="chanNum">2</SetVariable>
                                </Template>
                              </Children>
                            </WidgetGroup><!-- /track info for deck pairs -->

                            <WidgetGroup><!-- waveform pair stack: pairs stacked
                                full-width, 1|3 above 2|4 -->
                              <ObjectName>MingoPairColumns</ObjectName>
                              <Layout>vertical</Layout>
                              <SizePolicy>me,me</SizePolicy>
                              <Children>

                                <Template src="skins:Mingo/deck_pair_waveform.xml">
                                  <SetVariable name="chanTop">1</SetVariable>
                                  <SetVariable name="chanBottom">3</SetVariable>
                                  <SetVariable name="LabelText">1|3</SetVariable>
                                  <SetVariable name="SignalColor_Pair"><Variable name="SignalColor_PairA"/></SetVariable>
                                  <SetVariable name="SignalBgColor_Pair"><Variable name="SignalBgColor_PairA"/></SetVariable>
                                </Template>

                                <WidgetGroup><Size>1me,4f</Size></WidgetGroup>

                                <Template src="skins:Mingo/deck_pair_waveform.xml">
                                  <SetVariable name="chanTop">2</SetVariable>
                                  <SetVariable name="chanBottom">4</SetVariable>
                                  <SetVariable name="LabelText">2|4</SetVariable>
                                  <SetVariable name="SignalColor_Pair"><Variable name="SignalColor_PairB"/></SetVariable>
                                  <SetVariable name="SignalBgColor_Pair"><Variable name="SignalBgColor_PairB"/></SetVariable>
                                </Template>

                              </Children>
                            </WidgetGroup><!-- /waveform pair stack -->
                          </Children>
                        </WidgetGroup><!-- /decks -->

                        <SingletonContainer><!-- library pane -->
                          <ObjectName>Library_Singleton</ObjectName>
                        </SingletonContainer><!-- /library pane -->

                      </Children>
                    </Splitter>
                    <!-- regular library with decks etc. -->

                    <!-- maximized library with minimal decks -->
                    <WidgetGroup>
                      <Layout>vertical</Layout>
                      <SizePolicy>me,me</SizePolicy>
                      <Connection>
                        <ConfigKey>[Skin],show_maximized_library</ConfigKey>
                        <BindProperty>visible</BindProperty>
                      </Connection>
                      <Children>

                        <WidgetGroup><!-- Minimal decks 1/2 -->
                          <Layout>horizontal</Layout>
                          <SizePolicy>me,max</SizePolicy>
                          <Children>
                            <Template src="skins:Mingo/decks/deck_left_mini.xml">
                              <SetVariable name="chanNum">1</SetVariable>
                            </Template>
                            <Template src="skins:Mingo/decks/deck_right_mini.xml">
                              <SetVariable name="chanNum">2</SetVariable>
                            </Template>
                          </Children>
                        </WidgetGroup>

                        <SingletonContainer>
                          <ObjectName>Library_Singleton</ObjectName>
                        </SingletonContainer>
                      </Children>
                    </WidgetGroup>
                    <!-- maximzed library with minimal decks -->

                  </Children>
                </WidgetStack>
                <!-- regular / maximized library -->

              </Children>
            </WidgetGroup><!-- topbar + skin elements -->

            <Template src="skins:Mingo/skin_settings.xml"/>

          </Children>
        </WidgetGroup><!-- visible skin + size settings menu -->


      </Children>
    </WidgetGroup>
    <!-- SkinContainer -->
    <!-- /skin incl. invisible size detector for deck Stars -->
  </Children>
</skin>
