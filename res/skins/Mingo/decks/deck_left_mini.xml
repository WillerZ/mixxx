<!--
Description:
  A minimal deck container
  | waveform |  track title |
  | overview | Key | artist |
Variables:
  chanNum : [ChannelN]
-->
<Template>
  <SetVariable name="group">[Channel<Variable name="chanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>DeckMini<Variable name="chanNum"/></ObjectName>
    <Layout>horizontal</Layout>
    <Size>504me,45f</Size>
    <Children>
      <WidgetGroup>
        <ObjectName>DeckContainerMini</ObjectName>
        <Layout>horizontal</Layout>
        <Size>i,40f</Size>
        <Children>

          <SingletonContainer>
            <ObjectName>DeckOverviewSingleton<Variable name="chanNum"/></ObjectName>
          </SingletonContainer>

          <WidgetGroup>
            <ObjectName>DeckMini_TitlePlayPosKeyBPM</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>f,me</SizePolicy>
            <MinimumSize>120,40</MinimumSize>
            <MaximumSize>200,40</MaximumSize>

            <Children>

              <WidgetGroup><!-- Title -->
                <Layout>horizontal</Layout>
                <Size>200me,20f</Size>
                <Children>
                  <TrackProperty>
                    <TooltipId>track_title</TooltipId>
                    <ObjectName>TrackTitleMini</ObjectName>
                    <Size>90me,20f</Size>
                    <Property>titleInfo</Property>
                    <Alignment>left</Alignment>
                    <Elide>right</Elide>
                    <Channel><Variable name="chanNum"/></Channel>
                  </TrackProperty>

                </Children>
              </WidgetGroup>

              <TrackWidgetGroup>
                <Size>0me,2f</Size>
                <Group><Variable name="group"/></Group>
                <TrackColorAlpha>255</TrackColorAlpha>
              </TrackWidgetGroup>

              <WidgetGroup><!-- by / Artist / Key -->
                <Layout>horizontal</Layout>
                <Size>120min,20f</Size>
                <Children>

                  <TrackProperty>
                    <TooltipId>track_title</TooltipId>
                    <ObjectName>TrackTitleMini</ObjectName>
                    <Size>100min,20f</Size>
                    <Property>artist</Property>
                    <Alignment>left</Alignment>
                    <Elide>right</Elide>
                    <Channel><Variable name="chanNum"/></Channel>
                  </TrackProperty>

                  <WidgetGroup><!-- Key Display/Match -->
                    <ObjectName>KeyDisplayMatch</ObjectName>
                    <Layout>stacked</Layout>
                    <SizePolicy>e,f</SizePolicy>
                    <MinimumSize>50,20</MinimumSize>
                    <MaximumSize>75,20</MaximumSize>
                    <Alignment>center</Alignment>
                    <Children>
                      <!-- KeyMatch, transparent -->
                      <Template src="skins:Mingo/controls/button_1state_right.xml">
                        <SetVariable name="TooltipId">sync_reset_key</SetVariable>
                        <SetVariable name="ObjectName">KeyMatchMini</SetVariable>
                        <SetVariable name="Size">30me,20f</SetVariable>
                        <SetVariable name="ConfigKey"><Variable name="group"/>,sync_key</SetVariable>
                        <SetVariable name="ConfigKeyRight"><Variable name="group"/>,reset_key</SetVariable>
                      </Template>

                      <Key><!-- Actual Key display -->
                        <TooltipId>visual_key</TooltipId>
                        <ObjectName>KeyDisplay</ObjectName>
                        <Channel><Variable name="chanNum"/></Channel>
                        <SizePolicy>e,f</SizePolicy>
                        <MinimumSize>50,19</MinimumSize>
                        <MaximumSize>75,19</MaximumSize>
                        <Alignment>left</Alignment>
                        <Elide>right</Elide>
                        <Connection>
                          <ConfigKey><Variable name="group"/>,visual_key</ConfigKey>
                        </Connection>
                      </Key>
                    </Children>
                    <Connection>
                      <ConfigKey persist="true">[Mingo],key_display_match</ConfigKey>
                      <BindProperty>visible</BindProperty>
                    </Connection>
                  </WidgetGroup><!-- /Key Display/Match -->

                </Children>
              </WidgetGroup><!-- Artist / Key -->

            </Children>
          </WidgetGroup>

        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
