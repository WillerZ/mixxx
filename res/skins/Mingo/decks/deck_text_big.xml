<!--
Description:
  Mingo: deck-pair header — big title with track key on the right,
  artist underneath, separated by the track-colour strip, then one
  track overview for the pair (the decks are hard-synced, so a single
  overview serves both). No time, no duration, no BPM (DESIGN.md: not
  needed).
Variables:
  chanNum   : channel number (the pair's lower-numbered, leading deck)
  SignalBgColor / SignalColor : pair colours (overview tint)
-->
<Template>
  <SetVariable name="group">[Channel<Variable name="chanNum"/>]</SetVariable>
  <WidgetGroup>
    <ObjectName>MingoDeckHeader</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>i,me</SizePolicy>
    <Children>

      <WidgetGroup><!-- Title + Key -->
        <Layout>horizontal</Layout>
        <SizePolicy>i,me</SizePolicy>
        <Children>

          <WidgetGroup><Size>4f,1min</Size></WidgetGroup>

          <TrackProperty><!-- Title -->
            <TooltipId>track_title</TooltipId>
            <ObjectName>MingoTrackTitle</ObjectName>
            <Property>titleInfo</Property>
            <Alignment>Left</Alignment>
            <Elide>right</Elide>
            <Size>1me,24f</Size>
            <Channel><Variable name="chanNum"/></Channel>
          </TrackProperty>

          <Key><!-- Key -->
            <ObjectName>MingoTrackKey</ObjectName>
            <Size>48f,24f</Size>
            <Group><Variable name="group"/></Group>
            <DisplayCents>false</DisplayCents>
          </Key>

          <WidgetGroup><Size>4f,1min</Size></WidgetGroup>
        </Children>
      </WidgetGroup><!-- /Title + Key -->

      <TrackWidgetGroup>
        <Size>0me,2f</Size>
        <Group><Variable name="group"/></Group>
        <TrackColorAlpha>255</TrackColorAlpha>
      </TrackWidgetGroup>

      <WidgetGroup><!-- by Artist -->
        <Layout>horizontal</Layout>
        <SizePolicy>i,me</SizePolicy>
        <Children>

          <WidgetGroup><Size>4f,1min</Size></WidgetGroup>

          <Label>
            <ObjectName>MingoTrackBy</ObjectName>
            <Size>22f,18f</Size>
            <Text>by </Text>
            <Alignment>left</Alignment>
          </Label>

          <TrackProperty><!-- Artist -->
            <TooltipId>track_artist</TooltipId>
            <ObjectName>MingoTrackArtist</ObjectName>
            <Elide>right</Elide>
            <Size>1me,18f</Size>
            <Property>artist</Property>
            <Channel><Variable name="chanNum"/></Channel>
          </TrackProperty>

          <WidgetGroup><Size>4f,1min</Size></WidgetGroup>
        </Children>
      </WidgetGroup><!-- /by Artist -->

      <WidgetGroup><!-- pair overview, tap to scan -->
        <Layout>vertical</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Size>0me,36f</Size>
        <Children>
          <Template src="skins:Mingo/decks/overview.xml">
            <SetVariable name="chanNum"><Variable name="chanNum"/></SetVariable>
            <SetVariable name="SignalBgColor"><Variable name="SignalBgColor"/></SetVariable>
            <SetVariable name="SignalColor"><Variable name="SignalColor"/></SetVariable>
          </Template>
        </Children>
      </WidgetGroup>

    </Children>
  </WidgetGroup>
</Template>
