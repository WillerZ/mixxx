<!--
Description:
  Slim Mingo top bar containing
  * Logo
  * FX Unit 1 chain preset selector (shows the active preset name)
  * recording button with duration display
  * Broadcast button
  * Clock
  * Skin Menu toggle
  The mixer, crossfader and GUI toggle switches are deliberately absent:
  this build is driven from the SC Live 4 hardware surface.
-->
<Template>
  <WidgetGroup>
    <ObjectName>Topbar</ObjectName>
    <Layout>horizontal</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>

      <WidgetGroup><!-- Logo -->
        <ObjectName>MixerBar</ObjectName>
        <Layout>horizontal</Layout>
        <Size>110f,32f</Size>
        <Children>

          <WidgetGroup><Size>4f,0</Size></WidgetGroup>
          <WidgetGroup>
            <Layout>vertical</Layout>
            <Children>
              <WidgetGroup><Size>0,5f</Size></WidgetGroup>
              <PushButton>
                <Size>102f,24f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Pressed scalemode="STRETCH_ASPECT">skins:Mingo/graphics/logo_102x24_grey.png</Pressed>
                  <Unpressed scalemode="STRETCH_ASPECT">skins:Mingo/graphics/logo_102x24_grey.png</Unpressed>
                </State>
                <State>
                  <Number>1</Number>
                  <Pressed scalemode="STRETCH_ASPECT">skins:Mingo/graphics/logo_102x24.png</Pressed>
                  <Unpressed scalemode="STRETCH_ASPECT">skins:Mingo/graphics/logo_102x24.png</Unpressed>
                </State>
                <Connection>
                  <ConfigKey>[Mingo],colorLogo</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup><!-- vertical centre pad -->

        </Children>
      </WidgetGroup><!-- /Logo -->

      <WidgetGroup><!-- Beat FX: the current slot's effect name (the SC
        Live 4 script shows one of these six, per SCLive4.beatFx.slot) -->
        <Layout>horizontal</Layout>
        <Children>

          <WidgetGroup><Size>16f,0</Size></WidgetGroup>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <Children>
              <WidgetGroup><Size>0,4f</Size></WidgetGroup>
                <WidgetGroup><!-- Beat FX slot 1: unit 1 effect 1 -->
                  <ObjectName>MingoFxPreset</ObjectName>
                  <Layout>horizontal</Layout>
                  <Size>240f,32f</Size>
                  <Children>
                    <EffectName>
                      <ObjectName>MingoFxSlot</ObjectName>
                      <EffectUnitGroup>[EffectRack1_EffectUnit1]</EffectUnitGroup>
                      <Effect>1</Effect>
                      <Alignment>left</Alignment>
                    </EffectName>
                  </Children>
                  <Connection>
                    <ConfigKey>[Mingo],fx_slot_1</ConfigKey>
                    <BindProperty>visible</BindProperty>
                  </Connection>
                </WidgetGroup>
                <WidgetGroup><!-- Beat FX slot 2: unit 1 effect 2 -->
                  <ObjectName>MingoFxPreset</ObjectName>
                  <Layout>horizontal</Layout>
                  <Size>240f,32f</Size>
                  <Children>
                    <EffectName>
                      <ObjectName>MingoFxSlot</ObjectName>
                      <EffectUnitGroup>[EffectRack1_EffectUnit1]</EffectUnitGroup>
                      <Effect>2</Effect>
                      <Alignment>left</Alignment>
                    </EffectName>
                  </Children>
                  <Connection>
                    <ConfigKey>[Mingo],fx_slot_2</ConfigKey>
                    <BindProperty>visible</BindProperty>
                  </Connection>
                </WidgetGroup>
                <WidgetGroup><!-- Beat FX slot 3: unit 1 effect 3 -->
                  <ObjectName>MingoFxPreset</ObjectName>
                  <Layout>horizontal</Layout>
                  <Size>240f,32f</Size>
                  <Children>
                    <EffectName>
                      <ObjectName>MingoFxSlot</ObjectName>
                      <EffectUnitGroup>[EffectRack1_EffectUnit1]</EffectUnitGroup>
                      <Effect>3</Effect>
                      <Alignment>left</Alignment>
                    </EffectName>
                  </Children>
                  <Connection>
                    <ConfigKey>[Mingo],fx_slot_3</ConfigKey>
                    <BindProperty>visible</BindProperty>
                  </Connection>
                </WidgetGroup>
                <WidgetGroup><!-- Beat FX slot 4: unit 2 effect 1 -->
                  <ObjectName>MingoFxPreset</ObjectName>
                  <Layout>horizontal</Layout>
                  <Size>240f,32f</Size>
                  <Children>
                    <EffectName>
                      <ObjectName>MingoFxSlot</ObjectName>
                      <EffectUnitGroup>[EffectRack1_EffectUnit2]</EffectUnitGroup>
                      <Effect>1</Effect>
                      <Alignment>left</Alignment>
                    </EffectName>
                  </Children>
                  <Connection>
                    <ConfigKey>[Mingo],fx_slot_4</ConfigKey>
                    <BindProperty>visible</BindProperty>
                  </Connection>
                </WidgetGroup>
                <WidgetGroup><!-- Beat FX slot 5: unit 2 effect 2 -->
                  <ObjectName>MingoFxPreset</ObjectName>
                  <Layout>horizontal</Layout>
                  <Size>240f,32f</Size>
                  <Children>
                    <EffectName>
                      <ObjectName>MingoFxSlot</ObjectName>
                      <EffectUnitGroup>[EffectRack1_EffectUnit2]</EffectUnitGroup>
                      <Effect>2</Effect>
                      <Alignment>left</Alignment>
                    </EffectName>
                  </Children>
                  <Connection>
                    <ConfigKey>[Mingo],fx_slot_5</ConfigKey>
                    <BindProperty>visible</BindProperty>
                  </Connection>
                </WidgetGroup>
                <WidgetGroup><!-- Beat FX slot 6: unit 2 effect 3 -->
                  <ObjectName>MingoFxPreset</ObjectName>
                  <Layout>horizontal</Layout>
                  <Size>240f,32f</Size>
                  <Children>
                    <EffectName>
                      <ObjectName>MingoFxSlot</ObjectName>
                      <EffectUnitGroup>[EffectRack1_EffectUnit2]</EffectUnitGroup>
                      <Effect>3</Effect>
                      <Alignment>left</Alignment>
                    </EffectName>
                  </Children>
                  <Connection>
                    <ConfigKey>[Mingo],fx_slot_6</ConfigKey>
                    <BindProperty>visible</BindProperty>
                  </Connection>
                </WidgetGroup>
            </Children>
          </WidgetGroup><!-- vertical centre pad -->

        </Children>
      </WidgetGroup><!-- /Beat FX slot name -->

      <WidgetGroup><SizePolicy>me,min</SizePolicy></WidgetGroup><!-- spacer -->

      <WidgetGroup><!-- Skin controls: Rec, Broadcast, Battery, Clock, Skin menu toggle -->
        <Layout>horizontal</Layout>
        <ObjectName>SkinControlsBar</ObjectName>
        <SizePolicy>min,min</SizePolicy>
        <Children>

          <WidgetGroup><!-- Recording button & recording duration label -->
            <ObjectName>RecBox</ObjectName>
            <Layout>stacked</Layout>
            <Size>70f,28f</Size>
            <Children>
              <!-- invisible Rec button -->
              <Template src="skins:Mingo/controls/button_3state_display.xml">
                <SetVariable name="ObjectName">RecButton</SetVariable>
                <SetVariable name="TooltipId">toggle_recording</SetVariable>
                <SetVariable name="Size">70f,28f</SetVariable>
                <SetVariable name="ConfigKey">[Recording],toggle_recording</SetVariable>
                <SetVariable name="ConfigKeyDisp">[Recording],status</SetVariable>
              </Template>

              <WidgetGroup><!-- Rec dot + RecDuration -->
                <Layout>horizontal</Layout>
                <Size>70f,28f</Size>
                <Children>
                  <Template src="skins:Mingo/controls/button_3state_display.xml">
                    <SetVariable name="ObjectName">RecDot</SetVariable>
                    <SetVariable name="TooltipId">toggle_recording</SetVariable>
                    <SetVariable name="Size">15f,16f</SetVariable>
                    <SetVariable name="state_0_text">&#9679;</SetVariable>
                    <SetVariable name="state_1_text">&#9679;</SetVariable>
                    <SetVariable name="state_2_text">&#9679;</SetVariable>
                    <SetVariable name="Align">right</SetVariable>
                    <SetVariable name="ConfigKeyDisp">[Recording],status</SetVariable>
                  </Template>
                  <RecordingDuration>
                    <ObjectName>RecDuration</ObjectName>
                    <Size>55f,28f</Size>
                    <InactiveText>REC</InactiveText>
                    <Alignment>center</Alignment>
                  </RecordingDuration>
                </Children>
              </WidgetGroup><!-- /Rec dot + RecDuration -->
            </Children>
          </WidgetGroup><!-- /Recording button & recording duration label -->

          <WidgetGroup><Size>7f,1min</Size></WidgetGroup>

          <Template src="skins:Mingo/controls/button_5state_display.xml">
            <SetVariable name="TooltipId">broadcast_enabled</SetVariable>
            <SetVariable name="ObjectName">BroadcastButton</SetVariable>
            <SetVariable name="Size">24f,32f</SetVariable>
            <SetVariable name="ConfigKey">[Shoutcast],enabled</SetVariable>
            <SetVariable name="ConfigKeyDisp">[Shoutcast],status</SetVariable>
          </Template>

          <Battery>
            <ObjectName>Battery</ObjectName>
            <Size>24,24</Size>
            <SizePolicy>f,f</SizePolicy>
            <PixmapCharged scalemode="STRETCH_ASPECT">skins:Mingo/graphics/batt/ic_battery_charged.svg</PixmapCharged>
            <NumberStates>8</NumberStates>
            <PixmapsCharging scalemode="STRETCH_ASPECT">skins:Mingo/graphics/batt/ic_battery_charging_%1.svg</PixmapsCharging>
            <PixmapsDischarging scalemode="STRETCH_ASPECT">skins:Mingo/graphics/batt/ic_battery_discharging_%1.svg</PixmapsDischarging>
          </Battery>

          <WidgetGroup><!-- Clock + latency display -->
            <ObjectName>ClockBox</ObjectName>
            <MinimumSize>52,28</MinimumSize>
            <MaximumSize>64,28</MaximumSize>
            <SizePolicy>max</SizePolicy>
            <Layout>vertical</Layout>
            <Children>

              <WidgetGroup>
                <SizePolicy>me,me</SizePolicy>
                <Layout>horizontal</Layout>
                <Children>
                  <Time>
                    <TooltipId>time</TooltipId>
                    <ObjectName>Clock</ObjectName>
                    <Align>center</Align>
                  </Time>
                </Children>
              </WidgetGroup>

              <WidgetGroup>
                <ObjectName>AlignHCenter</ObjectName>
                <SizePolicy>me,me</SizePolicy>
                <Layout>horizontal</Layout>
                <Children>
                  <VuMeter><!-- latency usage -->
                    <Size>31f,3f</Size>
                    <TooltipId>audio_latency_usage</TooltipId>
                    <PathVu>skins:Mingo/graphics/latency_usage_over.svg</PathVu>
                    <PathBack>skins:Mingo/graphics/latency_usage.svg</PathBack>
                    <Horizontal>true</Horizontal>
                    <PeakHoldSize>5</PeakHoldSize>
                    <PeakHoldTime>1000</PeakHoldTime>
                    <PeakFallTime>100</PeakFallTime>
                    <PeakFallStep>1</PeakFallStep>
                    <Connection>
                      <ConfigKey>[App],audio_latency_usage</ConfigKey>
                    </Connection>
                  </VuMeter><!-- /latency usage -->
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup><!-- Clock + latency display -->

          <WidgetGroup><Size>3f,1min</Size></WidgetGroup>

          <WidgetGroup>
            <Layout>vertical</Layout>
            <SizePolicy>min,min</SizePolicy>
            <Children>
              <PushButton>
                <TooltipId>skin_settings</TooltipId>
                <ObjectName>SkinSettingsToggler</ObjectName>
                <Size>32f,32f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                </State>
                <State>
                  <Number>1</Number>
                </State>
                <Connection>
                  <ConfigKey>[Skin],show_settings</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
            </Children>
            <Connection>
              <ConfigKey>[Skin],show_settings</ConfigKey>
              <Transform><Not/></Transform>
              <BindProperty>visible</BindProperty>
            </Connection>
          </WidgetGroup>

        </Children>
      </WidgetGroup><!-- /Skin controls -->

    </Children>
  </WidgetGroup>
</Template>
