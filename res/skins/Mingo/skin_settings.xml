<!--
Description:
  The Mingo skin settings menu — deliberately slim. This skin is driven
  by touch, so only settings that change what the screen must show while
  the SC Live 4 surface keeps working live in the menu. Everything the
  hardware already controls (mixer, sampler rows, hotcue counts, FX
  unit count...) has no entry here.

  Original Tango menu: (c) the Mixxx skin authors, CC-BY-SA.
-->
<Template>
  <WidgetGroup>
    <ObjectName>SkinSettingsContainer</ObjectName>
    <Layout>horizontal</Layout>
    <Size>200f,1me</Size>
    <Children>
      <WidgetGroup><Size>5f,1me</Size></WidgetGroup>
      <WidgetGroup>
        <ObjectName>SkinSettings</ObjectName>
        <Layout>vertical</Layout>
        <Size>195f,1me</Size>
        <Children>

          <WidgetGroup>
            <ObjectName>SkinSettingsHeader</ObjectName>
            <Layout>horizontal</Layout>
            <SizePolicy>me,f</SizePolicy>
            <Children>
              <Label>
                <ObjectName>CategoryLabel</ObjectName>
                <Text>Mingo</Text>
                <Size>160me,21f</Size>
              </Label>

              <PushButton>
                <TooltipId>skin_settings</TooltipId>
                <ObjectName>SkinSettingsClose</ObjectName>
                <Size>20f,20f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                </State>
                <State>
                  <Number>1</Number>
                </State>
                <Connection>
                  <ConfigKey>[Skin],show_settings</ConfigKey>
                  <ButtonState>LeftButton</ButtonState>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>

          <Label>
            <ObjectName>CategoryLabel</ObjectName>
            <Text>Display</Text>
            <Size>182me,21f</Size>
          </Label>

          <Template src="skins:Mingo/controls/skin_settings_button_2state.xml">
            <SetVariable name="text">4 Decks</SetVariable>
            <SetVariable name="Setting">[Skin],show_4decks</SetVariable>
          </Template>

          <Template src="skins:Mingo/controls/skin_settings_button_2state.xml">
            <SetVariable name="text">Maximized Library</SetVariable>
            <SetVariable name="Setting">[Skin],show_maximized_library</SetVariable>
          </Template>

          <Template src="skins:Mingo/controls/skin_settings_button_2state.xml">
            <SetVariable name="text">Intro &amp; Outro Cues</SetVariable>
            <SetVariable name="Setting">[Skin],show_intro_outro_cues</SetVariable>
          </Template>

          <WidgetGroup><!-- Expanding spacer -->
            <MinimumSize>1,2</MinimumSize>
            <MaximumSize>i,7</MaximumSize>
            <SizePolicy>me,min</SizePolicy>
          </WidgetGroup>

          <Label>
            <ObjectName>CategoryLabel</ObjectName>
            <Text>Mini Decks (maximized library)</Text>
            <Size>182me,21f</Size>
          </Label>

          <Template src="skins:Mingo/controls/skin_settings_button_2state.xml">
            <SetVariable name="text">Cover Art</SetVariable>
            <SetVariable name="Setting">[Skin],show_coverart</SetVariable>
          </Template>

          <Template src="skins:Mingo/controls/skin_settings_button_2state.xml">
            <SetVariable name="text">Spinners</SetVariable>
            <SetVariable name="Setting">[Skin],show_spinnies</SetVariable>
          </Template>

          <Template src="skins:Mingo/controls/skin_settings_button_2state.xml">
            <SetVariable name="text">Key (Match Indicator)</SetVariable>
            <SetVariable name="Setting">[Mingo],key_display_match</SetVariable>
          </Template>

          <WidgetGroup><!-- Expanding spacer -->
            <MinimumSize>1,2</MinimumSize>
            <MaximumSize>i,7</MaximumSize>
            <SizePolicy>me,min</SizePolicy>
          </WidgetGroup>

          <Label>
            <ObjectName>CategoryLabel</ObjectName>
            <Text>Branding</Text>
            <Size>182me,21f</Size>
          </Label>

          <Template src="skins:Mingo/controls/skin_settings_button_2state.xml">
            <SetVariable name="text">Colour Logo</SetVariable>
            <SetVariable name="Setting">[Mingo],colorLogo</SetVariable>
          </Template>

          <WidgetGroup><!-- Expanding spacer -->
            <MinimumSize>1,2</MinimumSize>
            <MaximumSize>i,i</MaximumSize>
            <SizePolicy>me,me</SizePolicy>
          </WidgetGroup>

        </Children>
      </WidgetGroup>
    </Children>
    <Connection>
      <ConfigKey>[Skin],show_settings</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
